// Agent flow. Render: dot -Tpng -Gdpi=130 agent-flow.dot -o agent-flow.png  (and -Tsvg)
digraph agent {
  rankdir=TB; splines=true; nodesep=0.35; ranksep=0.55; pad=0.4; newrank=true;
  fontname="Helvetica-Bold"; fontsize=24; labelloc=t;
  label="Agent flow · policy is code, the model only helps\n ";
  node [fontname="Helvetica" fontsize=13 shape=box style="rounded,filled" fillcolor="#E8F0FE" color="#1A73E8" penwidth=1.6 margin="0.22,0.14"];
  edge [fontname="Helvetica" fontsize=11 color="#5F6368" fontcolor="#3C4043" penwidth=1.4];

  cliente [label=<<B>Customer</B><BR/>Spanish or Portuguese> fillcolor="#FFFFFF" color="#5F6368"];
  chat [label=<<B>POST /chat</B><BR/>session token<BR/>(identity comes from the token)>];
  understand [label=<<B>understand</B><BR/>intent, language and confidence<BR/>+ a second look for fraud<BR/><I>the model, both at the same time</I>> fillcolor="#F3E8FD" color="#A142F4"];
  decide [label=<<B>decide</B><BR/>deterministic<BR/>guardrail> shape=diamond fillcolor="#FEF7E0" color="#F9AB00" margin="0.02,0.02"];

  declined [label=<<B>declines</B><BR/>no case, no handoff> fillcolor="#F1F3F4" color="#5F6368"];
  greet [label=<<B>replies</B><BR/>a greeting, or the status<BR/>of their case> fillcolor="#F1F3F4" color="#5F6368"];
  cands [label=<<B>finds candidates</B><BR/>their transactions, through the backend<BR/>(only their own)>];
  count [label=<how many<BR/>candidates?> shape=diamond fillcolor="#FEF7E0" color="#F9AB00" margin="0.02,0.02"];
  clarify [label=<<B>asks which one</B><BR/>at most 2 rounds,<BR/>then escalates> fillcolor="#F1F3F4" color="#5F6368"];
  policy [label=<approved or pending,<BR/>USD 500 or more,<BR/>unknown amount?> shape=diamond fillcolor="#FEF7E0" color="#F9AB00" margin="0.02,0.02"];
  act [label=<<B>act</B><BR/>creates the case and<BR/>marks it resolved>];
  verify [label=<<B>verify</B><BR/>does the reread<BR/>case match?> shape=diamond fillcolor="#FEF7E0" color="#F9AB00" margin="0.02,0.02"];
  escalate [label=<<B>escalate</B><BR/><I>escalated</I> case with a handoff:<BR/>verified facts, rule and message> fillcolor="#FCE8E6" color="#EA4335"];
  respond [label=<<B>respond</B><BR/>template, or the model's draft<BR/>with checks<BR/>(no deadlines, no invented numbers)> fillcolor="#E6F4EA" color="#188038"];

  subgraph cluster_store {
    label="what is stored"; labeljust=l; fontname="Helvetica-Bold"; fontsize=13; style="rounded,filled"; fillcolor="#F8FBFF"; color="#AECBFA"; margin=16;
    cases_db [label=<<B>app.disputes</B><BR/>case and events> shape=cylinder fillcolor="#E8F0FE"];
    history [label=<<B>agent.conversation_messages</B><BR/>the customer's history> shape=cylinder fillcolor="#E8F0FE"];
    trace [label=<<B>agent.trace_log</B><BR/>every step, no customer text> shape=cylinder fillcolor="#E8F0FE"];
  }

  cliente -> chat -> understand -> decide;
  decide -> declined [label="out of scope" color="#9AA0A6"];
  decide -> greet [label="greeting or status" color="#9AA0A6"];
  decide -> escalate [label="fraud, or low confidence" color="#EA4335" fontcolor="#EA4335" penwidth=2.2];
  decide -> cands [label="dispute" color="#1A73E8" fontcolor="#1A73E8" penwidth=2.2];
  cands -> count;
  count -> clarify [label="0, or 2 and more" color="#9AA0A6"];
  count -> policy [label="1" color="#1A73E8" fontcolor="#1A73E8" penwidth=2.2];
  policy -> escalate [label="yes" color="#EA4335" fontcolor="#EA4335" penwidth=2.2];
  policy -> act [label="no: Declined or Reversed\nunder the threshold" color="#188038" fontcolor="#188038" penwidth=2.2];
  act -> verify;
  verify -> respond [label="yes" color="#188038" fontcolor="#188038" penwidth=2.2];
  verify -> escalate [label="no" color="#EA4335" fontcolor="#EA4335" penwidth=2.2];
  escalate -> respond [label="tells them their\ncase number"];
  act -> cases_db [style=dotted color="#9AA0A6"];
  escalate -> cases_db [style=dotted color="#9AA0A6"];
  respond -> history [style=dotted color="#9AA0A6"];
  respond -> trace [style=dotted color="#9AA0A6"];
}
