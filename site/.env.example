# Copy to .env.local (ignored by git) and fill in.
# The address of the live app. The landing's "Live demo" buttons turn on when it is set.
NEXT_PUBLIC_DEMO_URL=
# Where the pitch video is served from. It is not in the repository, and it must answer range requests, or the video
# cannot be skipped through. Empty: the page says the video is not part of the build.
NEXT_PUBLIC_VIDEO_URL=
# The waker that wakes the sleeping demo (the app's address plus /waker). Empty: the "Live demo" links go straight to the app.
NEXT_PUBLIC_WAKER_URL=
