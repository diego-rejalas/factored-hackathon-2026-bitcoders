# Copy this file to .env (same folder) and fill in the values. .env is gitignored.
#
# Railway services do not read a .env file: they read environment variables. This file
# is only the source the values are loaded from once, with:
#
#   set -a; . ./.env; set +a
#   railway variable set \
#     LATAM_BANK_AWS_ACCESS_KEY_ID="$LATAM_BANK_AWS_ACCESS_KEY_ID" \
#     LATAM_BANK_AWS_SECRET_ACCESS_KEY="$LATAM_BANK_AWS_SECRET_ACCESS_KEY" \
#     --service airflow
#
# Read-only S3 credentials of the hackathon organizer (see the challenge material).
LATAM_BANK_AWS_ACCESS_KEY_ID=
LATAM_BANK_AWS_SECRET_ACCESS_KEY=
