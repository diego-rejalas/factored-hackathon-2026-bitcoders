# Copy to terraform.tfvars (gitignored) to run Terraform by hand. The workflow reads these from repository variables.
account_id         = "<Cloudflare account id>"
zone_id            = "<id of the zone that holds the app's name>"
app_hostname       = "app.example.com"
edge_ip            = "<the load balancer's reserved address>"
pages_project_name = "<pages project>"
r2_bucket_name     = "<bucket>"
