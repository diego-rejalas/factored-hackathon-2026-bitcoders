{
  "components": {
    "schemas": {
      "AdminSessionRequest": {
        "properties": {
          "password": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "AdminSessionRequest",
        "type": "object"
      },
      "AdminTransitionRequest": {
        "properties": {
          "action": {
            "pattern": "^(claim|close)$",
            "title": "Action",
            "type": "string"
          },
          "note": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Note",
            "type": "string"
          },
          "resolution": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolution"
          }
        },
        "required": [
          "action",
          "note"
        ],
        "title": "AdminTransitionRequest",
        "type": "object"
      },
      "ChatRequest": {
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "message": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "session_token": {
            "minLength": 1,
            "title": "Session Token",
            "type": "string"
          },
          "transaction_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The transaction the customer picked in the app. The backend checks it is theirs; one that is not is ignored.",
            "title": "Transaction Id"
          }
        },
        "required": [
          "session_token",
          "message"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ChatResponse": {
        "properties": {
          "candidates": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Candidates"
          },
          "case": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case"
          },
          "case_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The dispute case this turn opened or found, if any.",
            "title": "Case Id"
          },
          "case_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Status"
          },
          "conversation_id": {
            "title": "Conversation Id",
            "type": "string"
          },
          "handoff": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Handoff"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "outcome": {
            "title": "Outcome",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "reply": {
            "title": "Reply",
            "type": "string"
          }
        },
        "required": [
          "reply",
          "conversation_id",
          "outcome"
        ],
        "title": "ChatResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "SessionRequest": {
        "properties": {
          "customer_id": {
            "minLength": 1,
            "title": "Customer Id",
            "type": "string"
          },
          "document_number": {
            "minLength": 1,
            "title": "Document Number",
            "type": "string"
          }
        },
        "required": [
          "customer_id",
          "document_number"
        ],
        "title": "SessionRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "\nConversational agent + deterministic guardrail for the Factored AI & Data\nHackathon 2026 prototype. The frontend only ever knows this service's URL:\n`POST /chat` runs the graph, `POST /session` and the `/admin/*` routes are\nthin proxies to the backend (which re-validates every token), and\n`/admin/agent-metrics` + `/admin/conversations/{id}/trace` are served from\n`agent.trace_log`, which this service owns. Limitations, stated explicitly:\n\n- The LangGraph checkpointer is in memory: conversation context is lost on\n  redeploy (accepted for the hackathon, documented as a limitation). The\n  trace and the handoff survive in Postgres even when the conversation does.\n- Tracing goes to `agent.trace_log` (best-effort); no chain-of-thought and\n  no user text is ever logged — only structured step metadata.\n- The agent never reads Postgres directly for banking data: everything\n  travels through the backend HTTP tools, forwarding the user's token.\n- Admin credentials are sandbox credentials (backend ADMIN_USERS); the demo\n  login is rate-limited in memory, per process.\n",
    "title": "banking-support-agent",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
