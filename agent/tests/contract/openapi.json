{
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "message": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "session_token": {
            "minLength": 1,
            "title": "Session Token",
            "type": "string"
          },
          "transaction_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The transaction the customer picked in the app. The backend checks it is theirs; one that is not is ignored.",
            "title": "Transaction Id"
          }
        },
        "required": [
          "session_token",
          "message"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ChatResponse": {
        "properties": {
          "case_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The dispute case this turn opened or found, if any.",
            "title": "Case Id"
          },
          "case_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Status"
          },
          "conversation_id": {
            "title": "Conversation Id",
            "type": "string"
          },
          "handoff": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Handoff"
          },
          "outcome": {
            "title": "Outcome",
            "type": "string"
          },
          "reply": {
            "title": "Reply",
            "type": "string"
          }
        },
        "required": [
          "reply",
          "conversation_id",
          "outcome"
        ],
        "title": "ChatResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "SessionRequest": {
        "properties": {
          "customer_id": {
            "minLength": 1,
            "title": "Customer Id",
            "type": "string"
          },
          "document_number": {
            "minLength": 1,
            "title": "Document Number",
            "type": "string"
          }
        },
        "required": [
          "customer_id",
          "document_number"
        ],
        "title": "SessionRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "\nConversational agent + deterministic guardrail for the Factored AI & Data\nHackathon 2026 prototype. Exposes `POST /chat` to the frontend and a thin\n`POST /session` proxy to the backend, so the frontend only ever needs this\nservice's URL. Limitations, stated explicitly:\n\n- The LangGraph checkpointer is in memory: conversation context is lost on\n  redeploy (accepted for the hackathon, documented as a limitation).\n- Tracing goes to `agent.trace_log` (best-effort); no chain-of-thought is\n  ever logged.\n- The agent never reads Postgres directly: all banking data travels through\n  the backend HTTP tools, forwarding the user's session token.\n",
    "title": "banking-support-agent",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/chat": {
      "post": {
        "operationId": "chat_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Chat",
        "tags": [
          "chat"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/session": {
      "post": {
        "operationId": "session_session_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Session Session Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Session",
        "tags": [
          "session"
        ]
      }
    }
  }
}
