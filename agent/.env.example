# Agent runtime env. Cloud Run injects these (see infra/gcp/envs);
# locally copy to agent/.env and load it before running uvicorn.

# Base URL of the backend banking service (the only source of banking data).
BANK_URL=http://localhost:8000

# Shared with the backend: lets the agent fail fast on invalid tokens before
# calling the backend, which re-validates anyway (double enforcement).
SESSION_JWT_SECRET=

# Admin sessions are issued by the backend with this TTL. The agent validates the
# shared JWT signature/issuer/role; it does not issue admin credentials itself.
ADMIN_TTL_MINUTES=480

# LLM via OpenRouter. Without a key the agent runs on deterministic fallback
# templates; with a key it drafts replies from verified facts only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Origins allowed to call the agent from a browser (exact origins, comma separated; never "*").
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cloud Run only: audience of the ID token sent to the private backend (X-Serverless-Authorization).
BANK_IAM_AUDIENCE=

# Deterministic guardrail: auto-resolve only below this effective USD amount.
GUARDRAIL_MAX_USD=500

# Postgres for the agent's own tables: agent.trace_log (audit trail, no user text) and
# agent.conversation_messages (the customer's history). The agent never reads gold.*.
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=data
