# Backend runtime env. Railway injects these (see .railway/railway.ts);
# locally copy to backend/.env and load it before running uvicorn.
# gold.* is read-only for this service; PG_* points at the Railway Postgres
# `data` database published by the pipeline.
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=data

# JWT secret for POST /session (HS256, short-lived tokens). Set it in Railway
# with preserve(); never commit a real value.
SESSION_JWT_SECRET=
SESSION_TTL_MINUTES=120
