# Backend runtime env. Cloud Run injects these (see infra/gcp/envs);
# locally copy to backend/.env and load it before running uvicorn.
# gold.* is read-only for this service; PG_* points at the Postgres
# `data` database published by the pipeline.
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=data

# JWT secret shared with agent/ (HS256, 32+ characters). Customer tokens keep sub=customer_id;
# admin tokens use sub=username and role=admin. Never commit a real value.
SESSION_JWT_SECRET=
SESSION_TTL_MINUTES=120

# Admin sandbox login. Value format: username:bcrypt_hash[,username:bcrypt_hash...]
# Generate each hash offline (see backend/README.md) and store the value in Secret Manager.
# ADMIN_USERS is intentionally empty here; admin login returns 503 until configured.
ADMIN_USERS=
ADMIN_TTL_MINUTES=480

# Must match agent/GUARDRAIL_MAX_USD: used by the deterministic demo scenario picker.
GUARDRAIL_MAX_USD=500
